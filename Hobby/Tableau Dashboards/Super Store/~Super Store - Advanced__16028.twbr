      <aliases enabled='yes' />
      <column caption='Box' datatype='string' name='[Calculation_1101494735478784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Orbit - DashPoints' datatype='integer' name='[Calculation_1101494742577153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;1&quot;) THEN 1 ELSE 360 END' />
      </column>
      <column caption='Orbit - X Axis' datatype='real' name='[Calculation_1101494742798338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIN(RADIANS(INDEX()))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orbit - Y Axis' datatype='real' name='[Calculation_1101494742945795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COS(RADIANS(INDEX()))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orbit % Complete' datatype='real' name='[Calculation_1101494743334917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([Sales]))/2 / [Parameters].[Parameter 1101494743150596]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orbit - Colors' datatype='integer' name='[Calculation_1101494743515142]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INDEX()/WINDOW_MAX(INDEX()) &lt; [Calculation_1101494743334917] THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Radial - Point' datatype='integer' name='[Calculation_1101494755708942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;1&quot;) THEN 0 ELSE 270 END' />
      </column>
      <column caption='Radial - LOD' datatype='real' name='[Calculation_1101494755958799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Category], [Segment]: SUM([Sales])}' />
      </column>
      <column caption='Radial - Rank' datatype='integer' name='[Calculation_1101494756085776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(-SUM([Calculation_1101494755958799]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Radial - X' datatype='real' name='[Calculation_1101494756237329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIN((INDEX()-1) * WINDOW_MAX(MAX(PI()))/180) * WINDOW_MAX([Calculation_1101494756085776])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Radial - Y' datatype='real' name='[Calculation_1101494756311058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COS((INDEX()-1) * WINDOW_MAX(MAX(PI()))/180) * WINDOW_MAX([Calculation_1101494756085776])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption=' Cate - Abr' datatype='string' name='[Calculation_1101494758223895]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Category] = &quot;Furniture&quot; THEN &quot;Furn&quot;&#13;&#10;ELSEIF [Category] = &quot;Office Supplies&quot; THEN &quot;Ofs&quot;&#13;&#10;ELSEIF [Category] = &quot;Technology&quot; THEN &quot;Tech&quot;&#13;&#10;END' />
      </column>
      <column caption='Norm - Metrics' datatype='real' name='[Calculation_1101494762418208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - WINDOW_MIN(SUM([Sales]))) / &#13;&#10;(WINDOW_MAX(SUM([Sales])) - WINDOW_MIN(SUM([Sales])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Norm Date' datatype='real' name='[Calculation_1101494762491937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(MIN([Order Date]) - WINDOW_MIN(MIN([Order Date]))) / &#13;&#10;(WINDOW_MAX(MAX([Order Date])) - WINDOW_MIN(MIN([Order Date])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Reversed Metric' datatype='real' name='[Calculation_1101494762676258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_1101494762418208]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Discount $' datatype='real' name='[Calculation_1101494769389605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Discount] = 0 THEN 0&#13;&#10;ELSE [Sales] * [Discount]&#13;&#10;END' />
      </column>
